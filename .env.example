# ==============================================================================
# CROWDWISDOM AI STUDIO — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this template to '.env' in the project root:
#      copy .env.example .env
# 2. Replace all placeholder values ('your_*', 'replace_with_*') with your real credentials.
# 3. NEVER commit '.env' or any secret-bearing files into version control!
# ==============================================================================

# --- 1. APPLICATION ENVIRONMENT & SECURITY ---
APP_ENV=development
# Generate a secure 32+ character random string for production (e.g. openssl rand -hex 32)
APP_SECRET_KEY=replace_with_secure_random_app_secret_min_32_chars
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# --- 2. DATABASE CONFIGURATION (MONGODB ATLAS OR LOCAL) ---
# Supports standard MongoDB URIs: mongodb://localhost:27017 or mongodb+srv://...
MONGODB_URL=mongodb://localhost:27017
# MONGODB_URI alias is also supported:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/
MONGODB_DB_NAME=crowdwisdom_ai_studio

# --- 3. CACHE & TASK QUEUE (OPTIONAL) ---
# REDIS_URL=redis://localhost:6379/0

# --- 4. JWT AUTHENTICATION ---
# Generate a secure random string for JWT token signing
JWT_SECRET_KEY=replace_with_secure_random_jwt_secret_min_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- 5. AI / LLM PROVIDER API CREDENTIALS ---
# Google Gemini API (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key

# OpenRouter API (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key

# NVIDIA NIM API (https://build.nvidia.com/)
NVIDIA_NIM_API_KEY=your_nvidia_api_key

# OpenAI API (Optional / Alternative: https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key

# Anthropic Claude API (Optional / Alternative: https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key

# --- 6. AD RESEARCH & WEB INTELLIGENCE PROVIDERS ---
# Apify Meta Ads Scraper Token (https://console.apify.com/account/integrations)
APIFY_API_TOKEN=your_apify_token

# Tavily Search API Key (https://app.tavily.com/)
TAVILY_API_KEY=your_tavily_api_key

# Exa Neural Search API Key (https://dashboard.exa.ai/)
EXA_API_KEY=your_exa_api_key

# --- 7. NOTIFICATION PROVIDERS (OPTIONAL) ---
# Resend Email API Key (https://resend.com/api-keys)
# RESEND_API_KEY=your_resend_api_key

# --- 8. FILE STORAGE & VIDEO RENDERING ---
MEDIA_DIR=./backend/media
MAX_VIDEO_SIZE_MB=500
